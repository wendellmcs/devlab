#!/usr/bin/env bash
# devlab-chamada — origina uma chamada SIP reproduzível dentro do lab.
#
# Por que existe: as lições da trilha G ensinam a LER uma chamada, e para isso
# o aluno precisa de uma chamada acontecendo. Pedir que ele monte o par UAC/UAS
# do SIPp na primeira lição seria ensinar a ferramenta antes do protocolo — o
# contrário do que a trilha se propõe.
#
# O que ela produz é real: dois processos SIPp conversando por 127.0.0.1, com
# INVITE → 180 → 200 → ACK → RTP → BYE → 200, SDP negociado em PCMA e mídia nos
# dois sentidos (o lado que atende usa -rtp_echo, então devolve o que recebe).
#
# O registro que ela deixa é do ENDPOINT, não da captura — ver a decisão 21 em
# docs/DESIGN-VOIP.md. O arquivo de estatísticas do SIPp diz quantas chamadas
# CADA LADO considerou bem-sucedidas, e é isso que um check deve consultar para
# saber se a chamada completou. Atenção: é um veredito de SINALIZAÇÃO. Uma
# chamada muda continua contando como bem-sucedida aqui, e é justamente por isso
# que "completou" e "tem áudio" são duas perguntas diferentes.
#
# `--destino` troca o COMPORTAMENTO de quem atende. Os nomes são sintomas ("o
# ramal deu ocupado"), nunca códigos: quem liga para um telefone descobre o
# código lendo a resposta, e é isso que a trilha ensina. Um `--destino 486`
# entregaria de graça a resposta do exercício na própria linha de comando.
set -uo pipefail

PORTA_SIP=5060
PORTA_SIP_ORIGEM=5061
RTP_DESTINO=6000
RTP_ORIGEM=6100
REGISTRO=/var/lib/devlab/ultima-chamada
CENARIOS=/usr/share/sipp/cenarios
# Escrito pelo `lab.break` da lição que quer que a chamada JÁ nasça com defeito.
# Sem ele o destino é `atende`, e é isso que mantém a lição 1 inalterada.
DESTINO_PADRAO=/var/lib/devlab/destino-padrao

duracao=1        # quantas chamadas
silencioso=0
destino=""
# O número discado, que vira o usuário da Request-URI (`INVITE sip:NUMERO@...`).
# `service` é o padrão do SIPp e fica como padrão aqui para não mudar a chamada
# que a lição 1 já gravou. Trocá-lo é o que permite ter, numa captura só, várias
# chamadas distinguíveis — que é como se isola uma chamada no dia a dia.
numero=service

# Nome do sintoma → cenário de quem atende. Só `atende` completa a chamada e
# devolve áudio; os outros recusam, cada um com o seu código final.
cenario_de() {
  case "$1" in
    atende)       echo "uas-com-audio.xml" ;;
    ocupado)      echo "uas-ocupado.xml" ;;
    desconhecido) echo "uas-desconhecido.xml" ;;
    ausente)      echo "uas-ausente.xml" ;;
    sem-codec)    echo "uas-sem-codec.xml" ;;
    sobrecarga)   echo "uas-sobrecarga.xml" ;;
    *) return 1 ;;
  esac
}

while [ $# -gt 0 ]; do
  case "$1" in
    -n|--chamadas)  duracao="$2"; shift 2 ;;
    -q|--silencioso) silencioso=1; shift ;;
    -d|--destino)   destino="$2"; shift 2 ;;
    -N|--numero)    numero="$2"; shift 2 ;;
    -h|--ajuda)
      sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
      echo
      echo "  --destino atende|ocupado|desconhecido|ausente|sem-codec|sobrecarga"
      echo "  --numero  NUMERO discado (padrão: service)"
      exit 0 ;;
    *) echo "opção desconhecida: $1" >&2; exit 2 ;;
  esac
done

if [ -z "$destino" ]; then
  if [ -r "$DESTINO_PADRAO" ]; then
    destino=$(tr -d '[:space:]' < "$DESTINO_PADRAO")
  else
    destino=atende
  fi
fi

if ! CENARIO_UAS=$(cenario_de "$destino"); then
  echo "destino desconhecido: $destino" >&2
  echo "use um de: atende ocupado desconhecido ausente sem-codec sobrecarga" >&2
  exit 2
fi

dizer() { [ "$silencioso" -eq 1 ] || echo "$@"; }

mkdir -p "$REGISTRO"
rm -f "$REGISTRO"/*.csv 2>/dev/null

cd /usr/share/sipp || exit 1

# Restos de uma execução anterior seguram a porta 5060 e o segundo `devlab-chamada`
# falharia com "Fatal error binding a socket" — mensagem que não diz ao aluno
# que o problema é dele ter rodado duas vezes.
pkill -x sipp 2>/dev/null && sleep 1

dizer "→ atendendo em 127.0.0.1:$PORTA_SIP (aguardando INVITE)"
# Sem -rtp_echo de propósito: o cenário já toca áudio de volta, e somar o eco
# faria o lado que atende mandar mídia duas vezes — inclusive antes de quem
# ligou ter aberto a porta de RTP, o que enchia toda captura de "ICMP port
# unreachable". Ruído que o aluno não tem como explicar na primeira lição.
sipp -sf "$CENARIOS/$CENARIO_UAS" \
     -p "$PORTA_SIP" -i 127.0.0.1 \
     -min_rtp_port "$RTP_DESTINO" -max_rtp_port "$((RTP_DESTINO + 8))" \
     -trace_stat -stf "$REGISTRO/quem-atendeu.csv" \
     -bg >"$REGISTRO/quem-atendeu.log" 2>&1
sleep 1

dizer "→ ligando de 127.0.0.1:$PORTA_SIP_ORIGEM"
sipp -sn uac_pcap "127.0.0.1:$PORTA_SIP" -s "$numero" -i 127.0.0.1 -p "$PORTA_SIP_ORIGEM" \
     -min_rtp_port "$RTP_ORIGEM" -max_rtp_port "$((RTP_ORIGEM + 8))" \
     -m "$duracao" -r 1 -timeout 30 \
     -trace_stat -stf "$REGISTRO/quem-ligou.csv" \
     >"$REGISTRO/quem-ligou.log" 2>&1
codigo=$?

sleep 2
pkill -x sipp 2>/dev/null
sleep 1

# `SuccessfulCall(C)` é a coluna cumulativa de chamadas concluídas. O cabeçalho
# do CSV do SIPp tem quase cem colunas e a posição muda entre versões, então ela
# é localizada pelo NOME e não por índice.
concluidas() {
  local csv="$1"
  [ -f "$csv" ] || { echo 0; return; }
  awk -F';' '
    NR==1 { for (i = 1; i <= NF; i++) if ($i == "SuccessfulCall(C)") coluna = i; next }
    coluna && $coluna != "" { valor = $coluna }
    END { print valor + 0 }
  ' "$csv"
}

ligou=$(concluidas "$REGISTRO/quem-ligou.csv")

if [ "$codigo" -eq 0 ] && [ "$ligou" -gt 0 ]; then
  dizer "✔ chamada concluída — quem ligou contabilizou $ligou chamada(s) bem-sucedida(s)"
else
  dizer "✘ a chamada NÃO completou (sipp saiu com $codigo, $ligou bem-sucedida(s))"
  dizer "  o registro de cada lado está em $REGISTRO/"
fi

exit "$codigo"
