<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- UAS que ATENDE e devolve RTP PICOTADO — a chamada que o cliente reclama.

     A degradação NÃO é injetada na rede do lab; ela já vem dentro do arquivo
     de mídia (`pcap/g711a-picotado.pcap`, feito por `gerar-midia.py`). Os dois
     motivos estão medidos:

     1. `iptables` não serve. A captura se enxerta na camada de dispositivo,
        ANTES do netfilter (decisão 21), então um pacote descartado em INPUT
        aparece na gravação inteiro — e o aluno não teria perda nenhuma para
        MEDIR na captura dele.
     2. `tc netem` serve, e é aleatório. Perda e jitter mudariam a cada
        execução, e toda saída gravada de demonstração divergiria (decisão 27).

     Com o buraco de sequência dentro do próprio arquivo, a mesma chamada dá o
     mesmo veredito sempre: 225 pacotes recebidos, 24 perdidos (9,6%), com o
     espaçamento oscilando até 60 ms. Medido em execuções repetidas.

     A degradação fica só no sentido de QUEM ATENDE para QUEM LIGA. A
     assimetria é o conteúdo: quem ligou ouve picotado, quem atendeu ouve bem,
     e o sentido degradado é o que o aluno tem de nomear. -->
<scenario name="UAS que atende e devolve RTP picotado">

  <recv request="INVITE" crlf="true">
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=devlabSIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:];tag=devlabSIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8
      a=rtpmap:8 PCMA/8000

    ]]>
  </send>

  <!-- O ACK é obrigatório aqui, e não `optional="true"` como no cenário
       embutido: o SIPp recusa carregar um cenário com <nop> logo depois de um
       <recv optional>, porque não saberia em que momento começar a mídia.
       O erro que ele dá — "<recv> before <nop> sequence without a mandatory
       message" — sai no arquivo de erro e não na tela, então o sintoma
       aparente é um UAS que simplesmente não responde. -->
  <recv request="ACK" rtd="true" crlf="true">
  </recv>

  <!-- A mídia de volta, com os buracos de sequência já embutidos. -->
  <nop>
    <action>
      <exec play_pcap_audio="pcap/g711a-picotado.pcap"/>
    </action>
  </nop>

  <recv request="BYE">
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <timewait milliseconds="2000"/>

</scenario>
