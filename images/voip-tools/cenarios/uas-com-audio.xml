<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- UAS que ATENDE e devolve RTP — a linha de base audível do lab.

     Por que não usar o cenário `uas` embutido no SIPp:

     1. Ele nunca envia mídia. Responde a sinalização e pronto.
     2. Ele responde PCMU(0) a uma oferta de PCMA(8), ou seja, os dois lados
        nem sequer concordam no codec.

     O resultado é que, sozinho, o cenário embutido produz uma chamada que
     COMPLETA e não tem áudio em sentido nenhum. Isso torna impossível ensinar
     áudio unidirecional: sem um estado "funcionando" do qual a falha se
     distinga, o aluno não tem com o que comparar, e "sem áudio" deixa de ser
     um sintoma para virar o comportamento normal do lab.

     Aqui o codec da resposta casa com a oferta e o RTP volta. A falha passa a
     ser sempre injetada de propósito, e o aluno pode provar a diferença. -->
<scenario name="UAS que atende e devolve RTP">

  <recv request="INVITE" crlf="true">
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8
      a=rtpmap:8 PCMA/8000

    ]]>
  </send>

  <!-- O ACK é obrigatório aqui, e não `optional="true"` como no cenário
       embutido: o SIPp recusa carregar um cenário com <nop> logo depois de um
       <recv optional>, porque não saberia em que momento começar a mídia.
       O erro que ele dá — "<recv> before <nop> sequence without a mandatory
       message" — sai no arquivo de erro e não na tela, então o sintoma
       aparente é um UAS que simplesmente não responde. -->
  <recv request="ACK" rtd="true" crlf="true">
  </recv>

  <!-- A mídia de volta: é exatamente isto que o cenário embutido não tem. -->
  <nop>
    <action>
      <exec play_pcap_audio="pcap/g711a.pcap"/>
    </action>
  </nop>

  <recv request="BYE">
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <timewait milliseconds="2000"/>

</scenario>
